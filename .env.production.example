# =================================================================
# FoodLink Production Environment Configuration Template
# Copy this file to .env.production or set in your cloud container runtime (Cloud Run, ECS, Kubernetes)
# =================================================================

# Runtime Environment
NODE_ENV=production
PORT=3000

# Canonical Application Origin (Strict CORS Validation)
APP_URL=https://foodlink.org

# Google Gemini AI API Key (required for automated perishable food safety checks)
GEMINI_API_KEY=YOUR_PRODUCTION_GEMINI_API_KEY
GEMINI_SAFETY_MODEL=gemini-2.5-flash

# Firebase Admin Service Account Key JSON
# Provide single-line minified JSON string of your dedicated production Firebase Service Account
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Transactional Email Dispatch Provider for 6-Digit Email OTPs
# Option A: Resend (https://resend.com)
RESEND_API_KEY=re_your_production_resend_key
# Option B: SendGrid (https://sendgrid.com)
# SENDGRID_API_KEY=SG.your_production_sendgrid_key
EMAIL_FROM="FoodLink Security <auth@foodlink.org>"

# Google Maps Platform API Key (Client-side maps & geocoding)
VITE_GOOGLE_MAPS_API_KEY=YOUR_PRODUCTION_GOOGLE_MAPS_KEY

# CRITICAL SECURITY FLAG: Never set to true in production!
ENABLE_TEST_OTP=false
